# run.ps1 lee config/integrations.json. Las variables del proceso tienen prioridad.
OBRAPLAN_PORT=8080
OBRAPLAN_DATA=data/obraplan.json
OBRAPLAN_STATIC=src/main/resources/static
OBRAPLAN_VAULT=C:\cerebro_dev
# Opcional: modelo instalado en Ollama para el agente Python (--llm).
OBRAPLAN_OLLAMA_MODEL=
# Gemini: run.ps1 carga la clave protegida con scripts/configure_ai.ps1.
# También se puede proporcionar GEMINI_API_KEY como variable del proceso.
GEMINI_API_KEY=
OBRAPLAN_GEMINI_MODEL=gemini-3.5-flash-lite
